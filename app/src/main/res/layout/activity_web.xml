<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111F"
    android:orientation="vertical">

    <com.sikoclaw.app.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/browserBack"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#C8D7EA" />

        <ImageButton
            android:id="@+id/browserForward"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="#C8D7EA" />

        <ImageButton
            android:id="@+id/browserReload"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:padding="12dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#C8D7EA" />

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/browser_address_background"
            android:hint="Search or enter address"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:selectAllOnFocus="true"
            android:textColor="#F3F8FF"
            android:textColorHint="#8294AA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/browserTabs"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tabs"
            android:gravity="center"
            android:text="1"
            android:textColor="#36C5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/browserMenu"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#C8D7EA" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressDrawable="@drawable/web_progress_drawable" />

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
